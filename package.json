{
  "name": "ngxsmk-ui-kit",
  "version": "3.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGXSMK/ngxsmk-ui-kit.git"
  },
  "description": "NGXSMK — an Angular-first, MIT-licensed UI ecosystem: signals-native, zoneless components and a universal token engine.",
  "keywords": [
    "angular",
    "ui-kit",
    "design-system",
    "components",
    "signals",
    "zoneless",
    "theming",
    "dark-mode",
    "typescript"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run theme:css && npm run build:libs && npm run build:mcp && npm run build:demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test @ngxsmk/theme --watch=false && ng test @ngxsmk/cdk --watch=false && ng test @ngxsmk/core --watch=false",
    "test:coverage": "ng test @ngxsmk/cdk --watch=false --configuration=coverage && ng test @ngxsmk/theme --watch=false --coverage && ng test @ngxsmk/core --watch=false --coverage",
    "test:smoke:gen": "node tools/scripts/generate-smoke-specs.mjs",
    "test:smoke:check": "node tools/scripts/generate-smoke-specs.mjs --check",
    "theme:css": "tsx tools/scripts/generate-theme-css.ts",
    "build:libs": "ng build @ngxsmk/theme && ng build @ngxsmk/cdk && ng build @ngxsmk/core",
    "build:mcp": "npx tsc -p packages/mcp/tsconfig.json",
    "build:demo": "ng build demo",
    "size": "node tools/scripts/check-bundle-sizes.mjs --top 15",
    "size:update": "node tools/scripts/check-bundle-sizes.mjs --update",
    "check:zoneless": "node tools/scripts/check-zoneless.mjs",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "start:mcp": "node packages/mcp/dist/index.js",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "publish": "node tools/scripts/publish.mjs",
    "restore:toolchain": "node tools/scripts/gen-ci-angularjson.mjs --restore && npm install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "governance": "node tools/scripts/check-governance.mjs",
    "audit:consistency": "node tools/scripts/audit-component-consistency.mjs",
    "audit:a11y": "node tools/scripts/audit-a11y.mjs",
    "audit:complexity": "node tools/scripts/audit-component-complexity.mjs",
    "perf:lab": "node tools/scripts/performance-lab.mjs",
    "test:migration": "node tools/scripts/test-migration.mjs",
    "sitemap": "node tools/scripts/generate-sitemap.mjs",
    "audit:seo": "node tools/scripts/audit-seo.mjs",
    "audit:docs": "node tools/scripts/audit-docs.mjs",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.21.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "intl-tel-input": "^25.15.1",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "minisearch": "^7.2.0",
    "motion": "^14.11.1",
    "ngxsmk-datepicker": "^3.0.6",
    "ngxsmk-tel-input": "^1.8.4",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "ng-packagr": "^22.2.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  }
}
