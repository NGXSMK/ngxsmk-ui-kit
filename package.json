{
  "name": "ngxsmk-ui-kit",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "npm run theme:css && npm run build:libs && npm run build:demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test @ngxsmk/theme --watch=false && ng test @ngxsmk/cdk --watch=false && ng test @ngxsmk/core --watch=false",
    "theme:css": "tsx tools/scripts/generate-theme-css.ts",
    "build:libs": "ng build @ngxsmk/theme && ng build @ngxsmk/cdk && ng build @ngxsmk/core",
    "build:demo": "ng build demo",
    "publish": "node tools/scripts/publish.mjs",
    "restore:toolchain": "node tools/scripts/gen-ci-angularjson.mjs --restore && npm install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "intl-tel-input": "^25.15.1",
    "libphonenumber-js": "^1.13.8",
    "luxon": "^3.7.2",
    "motion": "^12.42.2",
    "ngxsmk-datepicker": "^2.3.1",
    "ngxsmk-tel-input": "^1.8.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.0",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
