{
  "name": "@ngxsmk/cli",
  "version": "3.0.0",
  "type": "module",
  "description": "CLI & schematics for the @ngxsmk signal-native Angular UI kit",
  "bin": {
    "ngxsmk": "./dist/index.js"
  },
  "schematics": "./collection.json",
  "ng-update": {
    "migrations": "./migration.json"
  },
  "files": [
    "dist",
    "collection.json",
    "migration.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@angular-devkit/core": ">=17.0.0",
    "@angular-devkit/schematics": ">=17.0.0",
    "@angular/cli": ">=17.0.0"
  },
  "dependencies": {
    "rxjs": ">=7.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGXSMK/ngxsmk-ui-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ngxsmk.github.io/ngxsmk-ui-kit",
  "bugs": {
    "url": "https://github.com/NGXSMK/ngxsmk-ui-kit/issues"
  }
}
