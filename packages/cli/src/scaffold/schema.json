{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "NgxsmkScaffold",
  "title": "NGXSMK scaffold",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Angular project name."
    },
    "type": {
      "type": "string",
      "enum": ["login", "dashboard", "settings", "ai-assistant", "ops-table"],
      "default": "login",
      "description": "Page recipe to generate.",
      "x-prompt": "Which recipe?"
    },
    "path": {
      "type": "string",
      "description": "Output folder (defaults to src/app/pages/<type>)."
    },
    "name": {
      "type": "string",
      "description": "Optional label stored as a file comment."
    }
  },
  "required": ["type"]
}
