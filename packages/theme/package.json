{
  "name": "@ngxsmk/theme",
  "version": "3.0.0",
  "description": "Runtime theming and design-token engine for @ngxsmk/core with light/dark modes and preset palettes.",
  "keywords": [
    "angular",
    "angular-theme",
    "theming",
    "design-tokens",
    "css-variables",
    "dark-mode",
    "themes",
    "tailwind",
    "tailwindcss"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NGXSMK/ngxsmk-ui-kit.git",
    "directory": "packages/theme"
  },
  "homepage": "https://ngxsmk.github.io/ngxsmk-ui-kit",
  "bugs": {
    "url": "https://github.com/NGXSMK/ngxsmk-ui-kit/issues"
  },
  "peerDependencies": {
    "@angular/common": ">=17.3.0",
    "@angular/core": ">=17.3.0",
    "@ionic/angular": ">=7.0.0 || >=8.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "@ionic/angular": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./tailwind": {
      "types": "./tailwind/index.d.ts",
      "default": "./tailwind/index.js"
    },
    "./tailwind/v3": {
      "types": "./tailwind/preset-v3.d.ts",
      "default": "./tailwind/preset-v3.js"
    },
    "./tailwind/v4.css": "./tailwind-v4.css"
  },
  "publishConfig": {
    "access": "public"
  }
}
